# Clave de OpenRouter (https://openrouter.ai/keys). Sin ella, la API responde
# solo con el modelo local, sin verificación cruzada.
OPENROUTER_API_KEY=

# Modelos de visión que verifican cada foto (separados por coma).
# VERIFICADORES=openai/gpt-5-mini,google/gemini-3.5-flash-lite

# Modelo de texto que arbitra los desacuerdos. Vacío = sin árbitro.
# ARBITRO=deepseek/deepseek-v4-flash

# HOST=127.0.0.1
# PORT=8080
# UMBRAL=0.5

# Techo total por modelo para los reintentos de OpenRouter, en segundos.
# VERIFICADOR_DEADLINE=180

# --- Límites de abuso ---
# Clasificar una foto cuesta 25-60 s de CPU y 2-3 llamadas pagas. Si publicás
# la API, poné además un límite de tamaño y de tasa en el proxy y un tope de
# gasto en la clave de OpenRouter.

# Tamaño máximo del upload, en bytes (10 MB).
# MAX_BYTES=10485760

# Megapíxeles máximos de la foto, para frenar bombas de descompresión.
# MAX_PIXELES=25000000

# Clasificaciones en paralelo. Cada una usa CPU y RAM; 1 es lo sano.
# CONCURRENCIA=1

# Pedidos por IP en la ventana (0 desactiva el límite).
# RATE_LIMITE=60
# RATE_VENTANA=3600

# Techo global de fotos verificadas por día (0 = sin techo). Pasado el techo la
# API sigue respondiendo, pero solo con el modelo local.
# CUOTA_DIARIA=500

# Regla de consenso. "arbitro" (default): una categoría que solo vieron los dos
# modelos de visión, sin respaldo del modelo local, la decide el árbitro.
# "confirma" vuelve a la regla vieja: más recall, sin defensa contra una
# inyección que engañe a los dos verificadores a la vez.
# CONSENSO_VLM_SOLO=arbitro

# Token compartido para POST /clasificar (header X-Api-Token). Vacío = abierto.
# API_TOKEN=

# Respuestas cacheadas por hash de foto, para no pagar dos veces la misma.
# CACHE_MAX=128

# Activalo SOLO si corrés detrás de un proxy propio: hace que el límite por IP
# use X-Forwarded-For. Sin proxy, cualquiera falsea el header y se lo saltea.
# CONFIAR_PROXY=1
